# Hermes Control — configuration (all optional; defaults shown)
# Copy to .env and export, or set in the systemd unit.

PORT=8089
HOST=127.0.0.1

# Integration mode: real = verified hermes CLI integration (default).
# mock = typed fixtures for UI development without a Hermes install. Never use mock in production.
HERMES_MODE=real

# Hermes profile home (default: ~/.hermes). Never put secrets here — the agent's
# API keys stay in $HERMES_HOME/.env and are only read server-side.
# HERMES_HOME=/root/.hermes
# HERMES_BIN=/root/.local/bin/hermes

# Hard cap for one chat generation, in seconds
CHAT_TIMEOUT_SECONDS=900
